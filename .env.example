# --- Persistence ------------------------------------------------------------
# PostgreSQL connection string used by Prisma. This variable is also the
# switch the composition root reads: set it and the app runs on the Prisma
# repository and a durable session table; leave it unset and it falls back to
# the in-memory adapters, which is enough for `next dev` and the test suite
# but loses every row and session on restart.
#
# After setting it, create the schema with:
#   npm run prisma:generate && npm run prisma:db-push
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/load_energy?schema=public"

# Throwaway database for the Prisma half of the repository contract test
# (`src/repository/prisma.test.ts`). Unset, that suite skips and `npm test`
# still passes. Its contents are deleted before every test, so never point it
# at a database you care about.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/load_energy_test?schema=public"

# --- Notifications: SMS via Twilio (required channel, Requirement 13.5) ------
# Missing values are not fatal at boot: the first send attempt fails and is
# recorded as an isolated notification failure (Requirement 13.7).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+16025550000"

# --- Notifications: optional email, sent where an address is on file (13.6) --
# Any SMTP relay works (Amazon SES SMTP, Postmark, Mailgun, internal relay).
# SMTP_PORT defaults to 587 (STARTTLS); 465 switches to implicit TLS.
SMTP_HOST="email-smtp.us-west-2.amazonaws.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Load Energy <alerts@loadenergy.example>"
# --- BOL ticket photos: S3-compatible object storage (Requirement 11.6) -----
# Optional. With no bucket configured, a delivery still records its gallons and
# ticket number and leaves the photo key null, retryable later.
# Credentials are read from the default AWS chain (task/instance role in
# production, AWS_* locally), so they are not named here.
S3_TICKET_BUCKET="load-energy-tickets"
AWS_REGION="us-west-2"
# Set only for a non-AWS S3-compatible store (MinIO, Cloudflare R2).
# S3_ENDPOINT="https://s3.example.com"
